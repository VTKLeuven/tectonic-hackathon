# Kopieer dit bestand naar server/.env. server/.env staat in .gitignore.

# Optie 1: Claude via de Anthropic API (heeft voorrang als hij ingevuld is)
# ANTHROPIC_API_KEY=sk-ant-...

# Optie 2: een OpenAI-compatibele server, bv. vLLM op "kenny" (qwen3.8-27b).
# Poort 8000 op kenny is enkel via SSH bereikbaar: `npm run tunnel` opent de tunnel (of `npm run dev` doet dat mee).
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=qwen3.8-27b
# LLM_API_KEY=

# Optioneel
PORT=3001
