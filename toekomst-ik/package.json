{
  "name": "toekomst-ik",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.5",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "concurrently -n app,server,tunnel -c blue,green,yellow --kill-others-on-fail=false \"npm:start\" \"npm:server\" \"npm:tunnel\"",
    "start": "expo start",
    "server": "tsx server/index.ts",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --import tsx --test \"engine/__tests__/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "lint": "expo lint",
    "export:check": "expo export --platform android --output-dir .expo-export-check && expo export --platform ios --output-dir .expo-export-check",
    "tunnel": "ssh -N -L 8000:127.0.0.1:8000 kenny"
  },
  "private": true
}
